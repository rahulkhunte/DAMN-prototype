# ===== DAMN Memory Network =====

# Pinata IPFS (https://pinata.cloud)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_secret_here
PINATA_JWT=your_pinata_jwt_here

# MCP server auth — requests from non-localhost must send this value
# in the X-AgenticMarket-Secret header (leave empty to disable auth)
AGENTICMARKET_SECRET=change_me

# Self-hosted IPFS node (Kubo) — primary pin store; Pinata is backup
LOCAL_IPFS_API=http://127.0.0.1:5001
LOCAL_IPFS_GATEWAY=http://127.0.0.1:8080

# Wallet (from MetaMask — NEVER commit actual key!)
PRIVATE_KEY=your_private_key_without_0x_prefix

# === RPC Endpoints ===
# Testnet (dev/demo)
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Production (pick one)
POLYGON_RPC=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
BASE_RPC=https://mainnet.base.org

# === Deployed Contract Addresses ===
CONTRACT_ADDRESS_SEPOLIA=0xacAABF9A47d1Df7f2f698ad9033da10CD374B8c4
CONTRACT_ADDRESS_POLYGON=   # fill after mainnet deploy
CONTRACT_ADDRESS_BASE=      # fill after Base deploy